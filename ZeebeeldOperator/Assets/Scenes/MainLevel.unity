  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    name: Chef Willem
    firstTimeSentences:
    - 'Hi, jij bent de gene die het vijandelijk schip moest vinden toch? '
    - Ik zag het schip toen ik even buiten pauze had. Maar ik Kon de letters niet
      zo goed lezen.
    - ik weet toevallig nog dat het schip richting het zuid-westen ging.
    - maar ik heb wel je hulp nodig met groente snijden.
    - Veel succes!
    repeatSentences:
    - dankjewel voor het helpen met snijden
  _hasTalked: 0
  onFirstDialogueEnded:
