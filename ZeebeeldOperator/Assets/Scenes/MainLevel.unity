  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    name: Elektricien Paulien
    firstTimeSentences:
    - Fijn, je bent er, ik heb je hulp echt hard nodig.
    - De stroom voor de radar ligt er uit maar ik krijg het zelf niet opgelost.
    - Zorg er voor dat de stroom vloeit van links onder naar rechts boven.
    - Je kunt op elk draadje klikken waardoor deze draait.
    repeatSentences:
    - Bedankt voor de hulp! Vergeet niet om op de radar te kijken.
  _hasTalked: 0
  onFirstDialogueEnded:
    m_PersistentCalls:
      m_Calls:
